{
  "name": "iagora-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "node --test --import ./tests-unit/register.mjs \"tests-unit/**/*.test.ts\"",
    "test:visual:update": "bash scripts/update-screenshots.sh",
    "api:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/lib/api/schema.d.ts"
  },
  "dependencies": {
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@internationalized/date": "3.12.4",
    "lucide-react": "0.545.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.32"
    }
  }
}

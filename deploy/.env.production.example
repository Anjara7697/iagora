# Copier vers deploy/.env (jamais versionné). Générer chaque secret :
#   openssl rand -hex 32        (hexadécimal : pas de caractères à échapper dans les URL)

# --- Application ---
# Instance d'essai (simulateur et workflow n8n autorisés) : ENVIRONMENT=development
# Production réelle (simulation refusée, garde-fous stricts) : ENVIRONMENT=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
# Liste JSON, origine exacte de la console (pas de "*", pas de localhost en production).
CORS_ORIGINS=["https://iagora.neosolve.info"]
# 32 caractères minimum.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Projet et réseau ---
# Un nom par environnement sur le même serveur : iagora-dev, iagora-prod…
IAGORA_PROJECT=iagora
# Ports publiés sur 127.0.0.1 uniquement (le reverse proxy de l'hôte les joint). À choisir libres :
# ss -ltnp | grep -E ':(8120|3130)\b'   (suggestion dev : 8120/3130 ; prod : 8020/3030)
IAGORA_API_PORT=8120
IAGORA_WEB_PORT=3130

# --- Console : figé à la construction de l'image ---
NEXT_PUBLIC_API_URL=https://iagora.neosolve.info/api/v1
NEXT_PUBLIC_ENABLE_SIMULATOR=false

# --- Bases de données ---
POSTGRES_USER=iagora
POSTGRES_PASSWORD=
POSTGRES_DB=iagora
MONGO_USER=iagora
MONGO_PASSWORD=
MONGO_DB=iagora

# --- Modèle de langage et base de connaissances ---
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Modèle de secours si le principal est saturé (même clé) ; réglable aussi dans Paramètres.
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# --- Agent ---
AGENT_AUTO_REPLY=true
FOLLOW_UP_WORKER_ENABLED=true

# --- Email IONOS : désactivé tant que la recette sur boîte de test n'est pas faite (docs/email.md) ---
EMAIL_ENABLED=false
EMAIL_SEND_ENABLED=false
EMAIL_SANDBOX_RECIPIENTS=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DATUM Academy

# --- Sauvegardes (deploy/backup.sh) ---
# Dossier lisible par l'utilisateur de déploiement. Défaut : /var/backups/iagora (droits root requis).
# BACKUP_DIR=/home/deploy/iagora-backups

# --- Version des images (étiquette) ---
IAGORA_TAG=latest

# --- Rendez-vous (docs/calendar.md) : none | google (demo est interdit en production) ---
CALENDAR_PROVIDER=none
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_DEFAULT_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me

# Clé de chiffrement des identifiants saisis dans la console (Intégrations). Facultative : à défaut,
# dérivée de JWT_SECRET_KEY. La changer oblige à ressaisir les mots de passe des connecteurs.
CONNECTORS_SECRET_KEY=

# Copier vers .env (non versionné) : cp .env.example .env
# Ne jamais commiter de valeur réelle (CdC S-04).

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL (utilisé aussi par docker-compose) ---
POSTGRES_USER=iagora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iagora
POSTGRES_DSN=postgresql+asyncpg://iagora:change-me@localhost:5432/iagora

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=iagora

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Authentification ---
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoire (32 caractères minimum) quand ENVIRONMENT=production.
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Modèle de langage (workflow agentique) ---
# Changer de fournisseur : LLM_PROVIDER (gemini | openai), LLM_MODEL et la clé correspondante.
# Aucune clé n'est jamais commitée : renseigner-la uniquement dans votre .env local.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# Modèle de secours si le principal est saturé (même clé) ; réglable aussi dans Paramètres.
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Déclenchement automatique et relances ---
# AGENT_AUTO_REPLY : l'agent prépare sa réponse dès qu'un message du prospect est enregistré.
# Relances : exécuteur de fond, fenêtre d'envoi (jours ouvrés, heure de Paris) et plafond sans réponse.
AGENT_AUTO_REPLY=true
FOLLOW_UP_WORKER_ENABLED=true
# Boucles de fond dans ce processus. Laisser true : l'API tourne en un seul processus (--workers 1).
# false seulement pour un second processus qui ne servirait que le HTTP.
BACKGROUND_WORKERS_ENABLED=true
FOLLOW_UP_INTERVAL_SECONDS=300
FOLLOW_UP_MAX_PER_SILENCE=3
# Seuils de décision de l'agent (D-27, réglables aussi dans Paramètres ; à confirmer par DATUM).
AGENT_MEETING_MIN_SCORE=50
AGENT_NURTURE_MAX_SCORE=24
AGENT_MIN_CONFIDENCE=0.5
# Termes qui engagent l'école, en plus de la liste intégrée, séparés par des virgules.
AGENT_EXTRA_TERMS=

# --- Connecteur email (IONOS) : voir docs/email.md ---
# Identifiants UNIQUEMENT dans votre .env local, jamais dans Git. Utiliser une boîte de TEST dédiée.
# Par défaut : désactivé, et même activé, rien n'est envoyé tant que EMAIL_SEND_ENABLED=false.
# EMAIL_SANDBOX_RECIPIENTS : l'agent n'écrit qu'à ces adresses (séparées par des virgules).
EMAIL_ENABLED=false
EMAIL_SEND_ENABLED=false
EMAIL_SANDBOX_RECIPIENTS=
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=DATUM Academy
EMAIL_IMAP_HOST=imap.ionos.fr
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.ionos.fr
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURITY=starttls
EMAIL_POLL_SECONDS=60

# --- Base de connaissances (RAG) ---
# Les embeddings réutilisent la clé du fournisseur (GEMINI_API_KEY). Changer de modèle impose
# `python -m app.cli kb-reindex`. RAG_MIN_SCORE : seuil de pertinence (voir docs/rag.md).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=4
RAG_MIN_SCORE=0.6

# --- Production (voir docs/revue-qualite.md) ---
# En production : ENVIRONMENT=production, DEBUG=false, CORS_ORIGINS=["https://console.votre-domaine"],
# JWT_SECRET_KEY de 32 caractères minimum. Côté frontend (au build) : NEXT_PUBLIC_ENABLE_SIMULATOR=false.
# Taille maximale d'une requête (Content-Length), 413 au-delà ; le proxy applique aussi sa limite.
MAX_REQUEST_BYTES=5000000
# Pays des numéros saisis sans indicatif (06… → +336…), format ISO à deux lettres.
PHONE_DEFAULT_REGION=FR

# --- Rendez-vous (voir docs/calendar.md) ---
# none : l'agent transfère les demandes de rendez-vous. demo : créneaux FICTIFS (interdit en production).
# google : agenda du conseiller (Google Calendar) + visioconférence Zoom.
CALENDAR_PROVIDER=none
CALENDAR_TIMEZONE=Europe/Paris
CALENDAR_SLOT_MINUTES=30
CALENDAR_WORK_DAYS=1,2,3,4,5
CALENDAR_WORK_START_HOUR=9
CALENDAR_WORK_END_HOUR=18
CALENDAR_MIN_NOTICE_HOURS=4
CALENDAR_HORIZON_DAYS=14
# Clé du compte de service Google, sur UNE ligne entre apostrophes (ou GOOGLE_SERVICE_ACCOUNT_FILE=chemin).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_DEFAULT_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER=me

# Clé de chiffrement des identifiants saisis dans la console (Intégrations). Facultative : à défaut,
# dérivée de JWT_SECRET_KEY. La changer oblige à ressaisir les mots de passe des connecteurs.
CONNECTORS_SECRET_KEY=

# --- Réglages avancés : valeurs par défaut, à décommenter seulement pour les changer ---
# API_V1_PREFIX=/api/v1
# APP_NAME=Agent Intelligent Commercial 2.0
# CORS_ORIGINS=["http://localhost:3000"]
# JWT_ALGORITHM=HS256
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT_SECONDS=30.0
# LLM_MAX_RETRIES=3
# FOLLOW_UP_WINDOW_START_HOUR=8
# FOLLOW_UP_WINDOW_END_HOUR=19
# FOLLOW_UP_WEEKDAYS_ONLY=true
# CALENDAR_BUFFER_MINUTES=0
# GOOGLE_SERVICE_ACCOUNT_FILE=
# EMAIL_IMAP_FOLDER=INBOX
# EMAIL_CREATE_UNKNOWN_SENDERS=true
# EMAIL_FOOTER=Pour ne plus recevoir de messages de notre part, répondez simplement STOP à cet email.
# EMAIL_AI_NOTICE=Ce message a été rédigé avec l'aide d'un assistant virtuel (IA) de DATUM Academy.
# EMAIL_BRAND_NAME=DATUM Academy
# EMAIL_BRAND_COLOR=#1f4fd8
# EMAIL_LOGO_URL=

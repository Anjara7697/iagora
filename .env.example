# Copier vers .env (non versionné) : cp .env.example .env
# Ne jamais commiter de valeur réelle (CdC S-04).

# --- Application ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- PostgreSQL (utilisé aussi par docker-compose) ---
POSTGRES_USER=iagora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iagora
POSTGRES_DSN=postgresql+asyncpg://iagora:change-me@localhost:5432/iagora

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=iagora

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (optionnel à ce stade) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
